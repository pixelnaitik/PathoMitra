{
  "name": "healthcare-os",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "Offline, on-device digital pathology laboratory management system — patient records, encrypted reports, billing and analytics.",
  "license": "MIT",
  "author": "Naitik Raj",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelnaitik/PathoMitra.git"
  },
  "bugs": {
    "url": "https://github.com/pixelnaitik/PathoMitra/issues"
  },
  "homepage": "https://github.com/pixelnaitik/PathoMitra#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:android": "node scripts/check-release-config.mjs && cross-env VITE_TARGET=native vite build && node scripts/check-native-assets.mjs",
    "sync:android": "npm run build:android && node -e \"require('fs').rmSync('android/app/src/main/assets/public',{recursive:true,force:true})\" && npx cap sync android && node scripts/check-native-assets.mjs --synced",
    "android:aab": "cd android && gradlew.bat bundleRelease",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "verify:android": "npm run build:android && npm run android:aab",
    "build:privacy": "tsx scripts/build-privacy-site.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "lint:ci": "tsc --noEmit && eslint . --max-warnings=21",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint:ci && npm run test:coverage && npm run build",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:first": "standard-version --first-release",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "pathology",
    "laboratory",
    "healthcare",
    "patient-records",
    "react",
    "vite",
    "capacitor",
    "offline-first",
    "tailwindcss"
  ],
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-printer": "^8.1.6",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nprogress": "^0.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.48.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
